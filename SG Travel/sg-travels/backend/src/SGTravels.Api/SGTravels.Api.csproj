<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>SGTravels.Api</RootNamespace>
    <UserSecretsId>sg-travels-api</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SGTravels.Core\SGTravels.Core.csproj" />
    <ProjectReference Include="..\SGTravels.Infrastructure\SGTravels.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The journey catalogue ships next to the binaries. -->
    <None Update="Data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
